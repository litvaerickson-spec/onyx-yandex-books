<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/eink_white">

    <!-- Верхняя панель навигации (36dp): четкие e-ink кнопки без обрезки текста -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:background="@color/eink_white">

        <Button
            android:id="@+id/btn_close_webview"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="Назад"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/eink_black"
            android:background="@drawable/btn_eink"
            android:includeFontPadding="false"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />

        <Button
            android:id="@+id/btn_open_keyboard"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="28dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="Клавиатура"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/eink_black"
            android:background="@drawable/btn_eink"
            android:includeFontPadding="false"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp" />

        <Button
            android:id="@+id/btn_native_input"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="28dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="Ввод текста"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/eink_black"
            android:background="@drawable/btn_eink"
            android:includeFontPadding="false"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginRight="4dp" />

        <Button
            android:id="@+id/btn_reload_webview"
            android:layout_width="36dp"
            android:layout_height="28dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="Обн"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/eink_black"
            android:background="@drawable/btn_eink"
            android:includeFontPadding="false"
            android:padding="0dp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/eink_black" />

    <!-- Компактная подсказка без обрезки текста -->
    <TextView
        android:id="@+id/auth_webview_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/eink_black"
        android:textColor="@color/eink_white"
        android:textSize="10sp"
        android:textStyle="bold"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:gravity="center_vertical"
        android:text="«Яндекс Ключ»: наведите на QR или войдите по логину"
        android:singleLine="true"
        android:ellipsize="end" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.onyx.yandexbooks.core.eink.EinkWebView
            android:id="@+id/auth_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/webview_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
