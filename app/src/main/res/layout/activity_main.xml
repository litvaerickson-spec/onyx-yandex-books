<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/eink_white">

    <!-- Верхняя панель инструментов (масштабируется через Настройки интерфейса ПО) -->
    <LinearLayout
        android:id="@+id/main_header_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:background="@color/eink_white">

        <TextView
            android:id="@+id/main_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Яндекс Книги Lite [BETA]"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/eink_black"
            android:singleLine="true"
            android:ellipsize="end" />

        <Button
            android:id="@+id/btn_toggle_reader_mode"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minHeight="34dp"
            android:minWidth="60dp"
            android:text="Onyx"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/eink_black"
            android:background="@drawable/btn_eink"
            android:includeFontPadding="false"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginRight="5dp" />

        <Button
            android:id="@+id/btn_check_update"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minHeight="34dp"
            android:minWidth="60dp"
            android:text="Обновить"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/eink_black"
            android:background="@drawable/btn_eink"
            android:includeFontPadding="false"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:visibility="gone"
            android:layout_marginRight="5dp" />

        <Button
            android:id="@+id/btn_main_menu"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minHeight="34dp"
            android:minWidth="74dp"
            android:text="Меню"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:textColor="@color/eink_black"
            android:background="@drawable/btn_eink"
            android:includeFontPadding="false"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/eink_black" />

    <!-- Вкладки полок и разделов (масштабируются через Настройки интерфейса ПО) -->
    <LinearLayout
        android:id="@+id/main_tabs_bar"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:background="@color/eink_white">

        <Button
            android:id="@+id/tab_reading_btn"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:layout_weight="1"
            android:text="Читаю (0)"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:textColor="@color/eink_black"
            android:background="@drawable/tab_eink_active"
            android:includeFontPadding="false"
            android:padding="0dp"
            android:layout_marginRight="2dp" />

        <Button
            android:id="@+id/tab_to_read_btn"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:layout_weight="1"
            android:text="В планах (0)"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:textColor="@color/eink_black"
            android:background="@drawable/tab_eink_inactive"
            android:includeFontPadding="false"
            android:padding="0dp"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp" />

        <Button
            android:id="@+id/tab_catalog_btn"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:layout_weight="1"
            android:text="Каталог"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:textColor="@color/eink_black"
            android:background="@drawable/tab_eink_inactive"
            android:includeFontPadding="false"
            android:padding="0dp"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp" />

        <Button
            android:id="@+id/tab_search_btn"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:layout_weight="1"
            android:text="Поиск"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:textColor="@color/eink_black"
            android:background="@drawable/tab_eink_inactive"
            android:includeFontPadding="false"
            android:padding="0dp"
            android:layout_marginLeft="2dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/eink_black" />

    <!-- Панель поиска книг (Search bar: 32dp) -->
    <LinearLayout
        android:id="@+id/search_bar_container"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="@color/eink_white"
        android:visibility="gone">

        <EditText
            android:id="@+id/search_query_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:hint="Название книги или автор..."
            android:textSize="11sp"
            android:textColor="@color/eink_black"
            android:textColorHint="@color/eink_dark_gray"
            android:background="@drawable/btn_eink"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:inputType="text" />

        <Button
            android:id="@+id/btn_search_submit"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="Найти"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/eink_black"
            android:background="@drawable/btn_eink_primary"
            android:includeFontPadding="false"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_marginLeft="6dp" />
    </LinearLayout>

    <View
        android:id="@+id/search_bar_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/eink_black"
        android:visibility="gone" />

    <!-- Индикатор синхронизации -->
    <TextView
        android:id="@+id/loading_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Синхронизация библиотеки с облаком Яндекса..."
        android:textSize="11sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="4dp"
        android:textColor="@color/eink_black"
        android:background="@drawable/btn_eink"
        android:visibility="gone" />

    <!-- Основная область списка книг -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Список книг на полке -->
        <com.onyx.yandexbooks.core.eink.EinkListView
            android:id="@+id/books_list_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/eink_black"
            android:dividerHeight="1dp"
            android:footerDividersEnabled="false"
            android:headerDividersEnabled="false"
            android:overScrollMode="never" />

        <!-- Пустое состояние (когда на полке нет книг) -->
        <LinearLayout
            android:id="@+id/empty_state_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/empty_shelf_title_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empty_shelf_title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/eink_black"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/empty_shelf_hint_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empty_shelf_hint"
                android:textSize="13sp"
                android:textColor="@color/eink_dark_gray"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btn_refresh_shelf"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Обновить список книг"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/eink_black"
                android:background="@drawable/btn_eink"
                android:paddingLeft="20dp"
                android:paddingRight="20dp" />
        </LinearLayout>

    </FrameLayout>

    <!-- Разделитель нижней панели -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/eink_black" />

    <!-- Нижняя статус-панель полки, версии ПО и постраничная навигация E-Ink -->
    <LinearLayout
        android:id="@+id/shelf_footer_bar"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@color/eink_white">

        <TextView
            android:id="@+id/shelf_footer_status"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="Книг: 0"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:textColor="@color/eink_black"
            android:singleLine="true"
            android:ellipsize="end" />

        <Button
            android:id="@+id/btn_shelf_prev_page"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minHeight="34dp"
            android:minWidth="56dp"
            android:text="&lt; Стр"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/eink_black"
            android:background="@drawable/btn_eink"
            android:includeFontPadding="false"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />

        <TextView
            android:id="@+id/shelf_page_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" 1/1 "
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:textColor="@color/eink_black"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp" />

        <Button
            android:id="@+id/btn_shelf_next_page"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minHeight="34dp"
            android:minWidth="56dp"
            android:text="Стр &gt;"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/eink_black"
            android:background="@drawable/btn_eink"
            android:includeFontPadding="false"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>

</LinearLayout>
