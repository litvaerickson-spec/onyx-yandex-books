<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eink_white">

    <!-- Нативный Canvas рендерер страницы книги -->
    <com.onyx.yandexbooks.ui.ReaderCanvasView
        android:id="@+id/reader_canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 1. Верхняя панель в стиле Onyx NeoReader -->
    <LinearLayout
        android:id="@+id/reader_top_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/eink_white"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="gone">

        <!-- Кнопка «Назад в библиотеку» -->
        <Button
            android:id="@+id/btn_reader_back"
            android:layout_width="44dp"
            android:layout_height="34dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="&lt;"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/btn_eink_text_color"
            android:background="@drawable/btn_eink"
            android:includeFontPadding="false" />

        <!-- Название книги -->
        <TextView
            android:id="@+id/reader_book_title_top"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Книга"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/eink_black"
            android:singleLine="true"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="8dp" />

        <!-- Кнопка аппаратного сброса дисплея E-Ink -->
        <Button
            android:id="@+id/btn_reader_refresh"
            android:layout_width="68dp"
            android:layout_height="34dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="Сброс"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/btn_eink_text_color"
            android:background="@drawable/btn_eink"
            android:includeFontPadding="false"
            android:layout_marginRight="4dp" />

        <!-- Кнопка закрытия меню -->
        <Button
            android:id="@+id/btn_reader_close_overlay"
            android:layout_width="40dp"
            android:layout_height="34dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="✕"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/btn_eink_text_color"
            android:background="@drawable/btn_eink"
            android:includeFontPadding="false" />

    </LinearLayout>

    <!-- Тонкий разделитель под верхней панелью -->
    <View
        android:id="@+id/reader_top_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/eink_black"
        android:layout_below="@id/reader_top_bar"
        android:visibility="gone" />

    <!-- 2. Нижняя панель управления в стиле Onyx NeoReader -->
    <LinearLayout
        android:id="@+id/reader_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="@color/eink_white"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <!-- Тонкий разделитель над нижней панелью -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/eink_black"
            android:layout_marginBottom="6dp" />

        <!-- Строка 1: Текущая глава слева + кнопки перехода к предыдущей/следующей главе -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/reader_chapter_title_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Глава 1"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/eink_black"
                android:singleLine="true"
                android:ellipsize="end" />

            <Button
                android:id="@+id/btn_prev_chapter"
                android:layout_width="40dp"
                android:layout_height="28dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="&lt;&lt;"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/btn_eink_text_color"
                android:background="@drawable/btn_eink"
                android:includeFontPadding="false"
                android:layout_marginRight="4dp" />

            <Button
                android:id="@+id/btn_next_chapter"
                android:layout_width="40dp"
                android:layout_height="28dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="&gt;&gt;"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/btn_eink_text_color"
                android:background="@drawable/btn_eink"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Строка 2: Слайдер прогресса по страницам (точно как в NeoReader!) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">

            <Button
                android:id="@+id/btn_slider_page_back"
                android:layout_width="32dp"
                android:layout_height="28dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="&lt;"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/btn_eink_text_color"
                android:background="@drawable/btn_eink"
                android:includeFontPadding="false" />

            <SeekBar
                android:id="@+id/reader_page_seekbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:paddingLeft="10dp"
                android:paddingRight="10dp" />

            <Button
                android:id="@+id/btn_slider_page_forward"
                android:layout_width="32dp"
                android:layout_height="28dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="&gt;"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/btn_eink_text_color"
                android:background="@drawable/btn_eink"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/reader_page_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1/1"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/eink_black"
                android:layout_marginLeft="6dp" />
        </LinearLayout>

        <!-- Панель настроек формата (показывается при нажатии [ Формат ]) -->
        <LinearLayout
            android:id="@+id/reader_format_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="4dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/eink_black"
                android:layout_marginBottom="4dp" />

            <!-- Верхняя панель подвкладок панели Формат: Вид | Формат | Между строк -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btn_subtab_view"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:text="Вид"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/btn_eink_text_color"
                    android:background="@drawable/btn_eink"
                    android:includeFontPadding="false"
                    android:layout_marginRight="3dp" />

                <Button
                    android:id="@+id/btn_subtab_format"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:text="Формат"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/btn_eink_text_color"
                    android:background="@drawable/btn_eink"
                    android:includeFontPadding="false"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="2dp" />

                <Button
                    android:id="@+id/btn_subtab_spacing"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:text="Между строк"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/btn_eink_text_color"
                    android:background="@drawable/btn_eink"
                    android:includeFontPadding="false"
                    android:layout_marginLeft="3dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/eink_gray"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp" />

            <!-- Контейнер подвкладки 1: Вид -->
            <LinearLayout
                android:id="@+id/layout_subtab_view_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Размер шрифта: ползунок со стрелками/кнопками — и + -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="95dp"
                        android:layout_height="wrap_content"
                        android:text="Размер шрифта"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/eink_black" />

                    <Button
                        android:id="@+id/btn_font_decrease"
                        android:layout_width="32dp"
                        android:layout_height="28dp"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:text="—"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/btn_eink_text_color"
                        android:background="@drawable/btn_eink"
                        android:includeFontPadding="false" />

                    <SeekBar
                        android:id="@+id/seekbar_font_size"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="24"
                        android:progress="6"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp" />

                    <Button
                        android:id="@+id/btn_font_increase"
                        android:layout_width="32dp"
                        android:layout_height="28dp"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:text="+"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/btn_eink_text_color"
                        android:background="@drawable/btn_eink"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/font_size_label"
                        android:layout_width="32dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="18"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/eink_black" />
                </LinearLayout>

                <!-- Вид шрифта (Font Family: Serif, Sans-Serif, Monospace) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Вид шрифта"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/eink_black" />

                    <Button
                        android:id="@+id/btn_toggle_font_family"
                        android:layout_width="140dp"
                        android:layout_height="28dp"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:text="Serif ∨"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/btn_eink_text_color"
                        android:background="@drawable/btn_eink"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <!-- Красная строка / Абзац -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Абзацный отступ"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/eink_black" />

                    <Button
                        android:id="@+id/btn_toggle_indent"
                        android:layout_width="140dp"
                        android:layout_height="28dp"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:text="20 px ∨"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/btn_eink_text_color"
                        android:background="@drawable/btn_eink"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- Контейнер подвкладки 2: Формат -->
            <LinearLayout
                android:id="@+id/layout_subtab_format_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Жирность шрифта -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Жирность текста"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/eink_black" />

                    <Button
                        android:id="@+id/btn_toggle_contrast"
                        android:layout_width="140dp"
                        android:layout_height="28dp"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:text="Жирный"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/btn_eink_text_color"
                        android:background="@drawable/btn_eink"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <!-- Переносы слов TeX -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Переносы слов (TeX)"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/eink_black" />

                    <Button
                        android:id="@+id/btn_toggle_hyphenation"
                        android:layout_width="140dp"
                        android:layout_height="28dp"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:text="Включены"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/btn_eink_text_color"
                        android:background="@drawable/btn_eink"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <!-- Контрастность E-Ink -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Контраст E-Ink"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/eink_black" />

                    <Button
                        android:id="@+id/btn_toggle_eink_contrast"
                        android:layout_width="140dp"
                        android:layout_height="28dp"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:text="Высокий"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/btn_eink_text_color"
                        android:background="@drawable/btn_eink"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- Контейнер подвкладки 3: Между строк -->
            <LinearLayout
                android:id="@+id/layout_subtab_spacing_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Межстрочный интервал -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Межстрочный интервал"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/eink_black" />

                    <Button
                        android:id="@+id/btn_toggle_line_spacing"
                        android:layout_width="140dp"
                        android:layout_height="28dp"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:text="1.25x ∨"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/btn_eink_text_color"
                        android:background="@drawable/btn_eink"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <!-- Боковые поля страницы -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Боковые поля (Л/П)"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/eink_black" />

                    <Button
                        android:id="@+id/btn_toggle_margins"
                        android:layout_width="140dp"
                        android:layout_height="28dp"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:text="Узкие (18) ∨"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/btn_eink_text_color"
                        android:background="@drawable/btn_eink"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <!-- Верхние и нижние поля -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Верх/низ поля"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/eink_black" />

                    <Button
                        android:id="@+id/btn_toggle_vert_margins"
                        android:layout_width="140dp"
                        android:layout_height="28dp"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:text="Стандарт ∨"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/btn_eink_text_color"
                        android:background="@drawable/btn_eink"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Тонкий разделитель перед главными 3 вкладками -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/eink_black"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp" />

        <!-- Строка 3: Три главные вкладки управления Onyx NeoReader -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Вкладка 1: Содержание (Оглавление) -->
            <Button
                android:id="@+id/btn_tab_toc"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="Содержание"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/btn_eink_text_color"
                android:background="@drawable/btn_eink"
                android:includeFontPadding="false"
                android:layout_marginRight="4dp" />

            <!-- Вкладка 2: Прогресс -->
            <Button
                android:id="@+id/btn_tab_progress"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="Прогресс"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/btn_eink_text_color"
                android:background="@drawable/btn_eink"
                android:includeFontPadding="false"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp" />

            <!-- Вкладка 3: Формат -->
            <Button
                android:id="@+id/btn_tab_format"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="Формат"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/btn_eink_text_color"
                android:background="@drawable/btn_eink"
                android:includeFontPadding="false"
                android:layout_marginLeft="4dp" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
