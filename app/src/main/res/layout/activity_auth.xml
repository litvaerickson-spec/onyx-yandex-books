<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/eink_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- Заголовок -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Вход в Яндекс Книги"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/eink_black"
            android:layout_marginBottom="8dp" />

        <!-- 1. Вход прямо на читалке -->
        <Button
            android:id="@+id/btn_open_webview"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="🌐 1. Войти прямо на читалке (Яндекс ID)"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/eink_white"
            android:background="#000000"
            android:layout_marginBottom="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/eink_black"
            android:layout_marginBottom="8dp" />

        <!-- 2. QR-код для телефона -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📱 2. Или отсканируйте камерой смартфона:"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/eink_black"
            android:gravity="center"
            android:layout_marginBottom="6dp" />

        <!-- Компактный, четкий QR-код (135dp) -->
        <ImageView
            android:id="@+id/qr_image"
            android:layout_width="135dp"
            android:layout_height="135dp"
            android:background="@color/eink_white"
            android:scaleType="fitCenter"
            android:layout_marginBottom="4dp" />

        <!-- Плашка со статусом -->
        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ожидание подтверждения со смартфона..."
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/eink_black"
            android:gravity="center"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/local_url_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="https://ntfy.sh/..."
            android:textSize="10sp"
            android:textColor="@color/eink_black"
            android:layout_marginBottom="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/eink_black"
            android:layout_marginBottom="8dp" />

        <!-- 3. Дополнительные способы входа -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_import_file"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:text="📁 Из файла"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/eink_black"
                android:background="@drawable/btn_eink"
                android:layout_marginRight="6dp" />

            <Button
                android:id="@+id/manual_token_button"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:text="✏️ Ввести токен"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/eink_black"
                android:background="@drawable/btn_eink"
                android:layout_marginRight="6dp" />

            <Button
                android:id="@+id/retry_button"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:text="🔄"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/eink_black"
                android:background="@drawable/btn_eink" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
