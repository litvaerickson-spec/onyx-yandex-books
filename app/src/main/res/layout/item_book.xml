<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:paddingTop="9dp"
    android:paddingBottom="9dp"
    android:gravity="center_vertical"
    android:background="@color/eink_white">

    <!-- Обложка книги: четкая, гармоничная (62x90dp) с рамкой 2px -->
    <ImageView
        android:id="@+id/book_cover"
        android:layout_width="62dp"
        android:layout_height="90dp"
        android:layout_marginRight="10dp"
        android:background="@drawable/cover_border"
        android:padding="2dp"
        android:scaleType="centerCrop" />

    <!-- Информативный блок книги -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/book_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Название книги"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/eink_black"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/book_author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Автор"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/eink_black"
            android:layout_marginTop="1dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Описание/Аннотация книги (3 полные строки с отличной читаемостью) -->
        <TextView
            android:id="@+id/book_annotation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Краткое описание сюжета книги..."
            android:textSize="11sp"
            android:textColor="@color/eink_black"
            android:layout_marginTop="2dp"
            android:maxLines="3"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.15" />

        <!-- Прогресс чтения и статус памяти (без обрезки) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <ProgressBar
                android:id="@+id/book_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="45dp"
                android:layout_height="5dp"
                android:progressDrawable="@drawable/progress_eink_bar"
                android:max="100"
                android:progress="0"
                android:layout_marginRight="6dp" />

            <TextView
                android:id="@+id/book_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/eink_black"
                android:singleLine="true" />

            <TextView
                android:id="@+id/book_status_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" • ☁ Сеть"
                android:textSize="10sp"
                android:textColor="@color/eink_black"
                android:singleLine="true"
                android:layout_marginLeft="3dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Компактные кнопки действий справа -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginLeft="6dp">

        <Button
            android:id="@+id/book_read_btn"
            android:layout_width="64dp"
            android:layout_height="32dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/btn_read"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/eink_white"
            android:background="@drawable/btn_eink_primary"
            android:includeFontPadding="false"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/book_download_btn"
            android:layout_width="64dp"
            android:layout_height="26dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="О книге"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/eink_black"
            android:background="@drawable/btn_eink"
            android:includeFontPadding="false"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>

</LinearLayout>
